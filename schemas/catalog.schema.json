{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:female-appearance-atlas:catalog:v1",
  "title": "女性之美公共核心数据契约",
  "type": "object",
  "required": ["meta", "categories", "entries", "boards", "references", "combinations"],
  "properties": {
    "meta": {"type": "object", "required": ["version", "entry_count", "category_count", "board_count"]},
    "categories": {"type": "array", "items": {"type": "object", "required": ["id", "name", "guide", "count"], "properties": {"id": {"type": "string"}, "count": {"type": "integer", "minimum": 0}}}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "boards": {"type": "array", "items": {"type": "object", "required": ["id", "image", "width", "height", "columns", "rows", "items"], "properties": {"image": {"$ref": "#/$defs/path"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "columns": {"type": "integer", "minimum": 1}, "rows": {"type": "integer", "minimum": 1}, "items": {"type": "array"}}}},
    "references": {"type": "array", "items": {"type": "object", "required": ["id", "title", "url"]}},
    "combinations": {"type": "array", "items": {"type": "object", "required": ["name", "entry_ids"], "properties": {"entry_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:\\\\]+$"},
    "visual": {"type": "object", "required": ["board", "image", "column", "row", "columns", "rows", "label", "aspect"], "properties": {"board": {"type": "string"}, "image": {"$ref": "#/$defs/path"}, "column": {"type": "integer", "minimum": 0}, "row": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 1}, "rows": {"type": "integer", "minimum": 1}, "aspect": {"type": "number", "exclusiveMinimum": 0}, "crop": {"type": "object", "required": ["x", "y", "width", "height", "sheet_width", "sheet_height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "sheet_width": {"type": "number", "exclusiveMinimum": 0}, "sheet_height": {"type": "number", "exclusiveMinimum": 0}}}}},
    "entry": {"type": "object", "required": ["id", "category", "dimension", "name", "en", "description", "design_tip", "related_reading", "visual"], "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*[0-9]{3,}$"}, "category": {"type": "string"}, "dimension": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "design_tip": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "related_reading": {"type": "array", "items": {"type": "string"}}, "visual": {"$ref": "#/$defs/visual"}, "wearing_visual": {"$ref": "#/$defs/visual"}, "fullbody_visual": {"$ref": "#/$defs/visual"}}, "additionalProperties": true}
  }
}
