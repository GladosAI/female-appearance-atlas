{
  "name": "female-appearance-atlas",
  "version": "0.4.0",
  "private": true,
  "description": "女性之美：可检索、可组合的女性角色外观素材仓库",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python tools/build_atlas.py --skip-package",
    "check": "python tools/validate_atlas.py",
    "check:metadata": "python tools/validate_atlas.py --metadata-only",
    "test": "python -m unittest discover -s tests -v",
    "test:browser": "node tools/qa/verify_repository_workflows.cjs && node tools/qa/verify_system_examples.cjs && node tools/qa/verify_community_tools.cjs && node tools/qa/verify_scenes.cjs",
    "images:offline": "node tools/prepare_image_exports.cjs",
    "test:web": "node tools/qa/verify_web_release.cjs",
    "check:generated": "python tools/build_atlas.py --check-generated"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "sharp": "0.35.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GladosAI/female-appearance-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/GladosAI/female-appearance-atlas/issues"
  },
  "homepage": "https://gladosai.github.io/female-appearance-atlas/"
}
